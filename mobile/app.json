{
  "expo": {
    "name": "Todu",
    "slug": "todu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "todu",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f6f8fa",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.todu.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Todu shares your location with the people you choose when you trigger an SOS.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Todu needs background location so it can keep your circle updated during an emergency even when the app is closed.",
        "NSCameraUsageDescription": "Todu captures photo evidence only while an SOS is active, and only if you enable it.",
        "NSMicrophoneUsageDescription": "Todu records audio evidence only while an SOS is active, and only if you enable it.",
        "NSBluetoothAlwaysUsageDescription": "Todu can relay your alert through nearby Todu devices when there is no mobile network.",
        "UIBackgroundModes": [
          "location",
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "package": "app.todu.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "VIBRATE",
        "WAKE_LOCK",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "CAMERA",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE"
      ],
      "blockedPermissions": [
        "android.permission.SEND_SMS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Todu needs background location so your circle can find you during an emergency.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8fa"
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Todu uses the camera flash as a torch beacon during an SOS. It never records.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-bridgefy",
      "./plugins/with-short-object-paths",
      "./plugins/with-sos-shortcuts"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
